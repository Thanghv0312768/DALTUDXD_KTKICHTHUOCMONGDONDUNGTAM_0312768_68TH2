<Window x:Class="giaodien0502.Views.Vatlieuxaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:giaodien0502.Views"
        mc:Ignorable="d"
        Title="Vatlieuxaml" Height="450" Width="600">
    <Grid>
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="THÔNG SỐ VẬT LIỆU" FontSize="18" FontWeight="Bold" 
               HorizontalAlignment="Center" Foreground="#2C3E50" Margin="0,0,0,15"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <GroupBox Header="Bê tông" Margin="0,0,0,10" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <Label Content="Cấp độ bền:"/>
                            <ComboBox Name="cbCapDoBen" Grid.Column="1" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="B15"/>
                                <ComboBoxItem Content="B20" IsSelected="True"/>
                                <ComboBoxItem Content="B25"/>
                                <ComboBoxItem Content="B30"/>
                            </ComboBox>

                            <Label Content="Cường độ chịu nén Rb (MPa):" Grid.Row="1"/>
                            <TextBox Name="txtRb" Grid.Row="1" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center" Text="11.5"/>

                            <Label Content="Mô đun đàn hồi Eb (MPa):" Grid.Row="2"/>
                            <TextBox Name="txtEb" Grid.Row="2" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center" Text="27000"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Cốt thép" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <Label Content="Cấp độ bền cốt thép:"/>
                            <ComboBox Name="cbCapDoBenThep" Grid.Column="1" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="CB240-T"/>
                                <ComboBoxItem Content="CB300-V" IsSelected="True"/>
                                <ComboBoxItem Content="CB400-V"/>
                            </ComboBox>

                            <Label Content="Cường độ chịu kéo Rs (MPa):" Grid.Row="1"/>
                            <TextBox Name="txtRs" Grid.Row="1" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center" Text="260"/>

                            <Label Content="Mô đun đàn hồi Es (MPa):" Grid.Row="2"/>
                            <TextBox Name="txtEs" Grid.Row="2" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center" Text="200000"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Name="btnLuu" Content="Lưu thông số" Width="100" Height="30" 
                Background="#27AE60" Foreground="White" Click="btnLuuVatLieu_Click"/>
                <Button Name="btnHuy" Content="Hủy" Width="80" Height="30" Margin="10,0,0,0" Click="btnHuy_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
