<Window x:Class="giaodien0502.Views.TaiTrong"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhập tải trọng chân cột" Height="400" Width="450" 
        WindowStartupLocation="CenterScreen" Background="#FBFCFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="THÔNG SỐ TẢI TRỌNG CHÂN CỘT" FontSize="16" FontWeight="Bold" 
                   HorizontalAlignment="Center" Foreground="#1F618D" Margin="0,0,0,20"/>

        <GroupBox Header="Tải trọng tác dụng tại mặt móng" Grid.Row="1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                    <RowDefinition Height="35"/>
                </Grid.RowDefinitions>

                <Label Content="Lực dọc tiêu chuẩn Ntc (kN):"/>
                <TextBox Name="txtNtc" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center" Text="1200"/>

                <Label Content="Mô men tiêu chuẩn Mxtc (kNm):" Grid.Row="1"/>
                <TextBox Name="txtMxtc" Grid.Row="1" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center" Text="150"/>

                <Label Content="Mô men tiêu chuẩn Mytc (kNm):" Grid.Row="2"/>
                <TextBox Name="txtMytc" Grid.Row="2" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center" Text="80"/>

                <Label Content="Lực cắt tiêu chuẩn Qxtc (kN):" Grid.Row="3"/>
                <TextBox Name="txtQxtc" Grid.Row="3" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center" Text="30"/>

                <Label Content="Lực cắt tiêu chuẩn Qytc (kN):" Grid.Row="4"/>
                <TextBox Name="txtQytc" Grid.Row="4" Grid.Column="1" Margin="0,4" VerticalContentAlignment="Center" Text="20"/>
            </Grid>
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Name="btnLuu" Content="Lưu tải trọng" Width="120" Height="30" 
                    Background="#E67E22" Foreground="White" Click="btnLuuTaiTrong_Click"/>
            <Button Name="btnHuy" Content="Hủy" Width="80" Height="30" Margin="10,0,0,0" Click="btnHuy_Click"/>
        </StackPanel>
    </Grid>
</Window>