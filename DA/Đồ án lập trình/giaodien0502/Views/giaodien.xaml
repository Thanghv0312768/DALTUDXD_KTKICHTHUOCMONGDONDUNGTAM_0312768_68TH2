<Window x:Class="giaodien0502.Views.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:giaodien0502.Views"
        mc:Ignorable="d"
        Title="Window1" Height="800" Width="1080">
    <Grid Margin="0,0,10,-16">
        <GroupBox Header=" " Height="700" Margin="0,10,713,74">
            <Label x:Name="lbl1" Content="Thông tin công trình " Height="48" Width="202" FontWeight="Bold" FontSize="18" Margin="49,-650,37,0"/>
        </GroupBox>
        <TabControl Margin="10,92,690,155" Background="White">
            <TabItem Header="Địa chất">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Height="597">
                    <GroupBox Header="Thông số các lớp đất" Margin="5" Padding="10" Height="515">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Label Content="Lực dính (c):" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtLucDinh" Grid.Row="0" Grid.Column="1" Margin="5"/>
                            <TextBlock Text="kN/m²" Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>

                            <Label Content="Góc ma sát (φ):" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtGocMaSat" Grid.Row="1" Grid.Column="1" Margin="5"/>
                            <TextBlock Text="độ" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>

                            <Label Content="Dung trọng (γ):" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtDungTrong" Grid.Row="2" Grid.Column="1" Margin="5"/>
                            <TextBlock Text="kN/m³" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>

                            <Label Content="Độ sệt (IL):" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtDoSet" Grid.Row="3" Grid.Column="1" Margin="5"/>

                            <Label Content="Modun (E):" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtModun" Grid.Row="4" Grid.Column="1" Margin="5"/>
                            <TextBlock Text="kPa" Grid.Row="4" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>

                            <Label Content="Chiều dày (h):" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtChieuDay" Grid.Row="5" Grid.Column="1" Margin="5"/>
                            <TextBlock Text="m" Grid.Row="5" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>

                            <Label Content="Độ sâu MNN:" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtMNN" Grid.Row="6" Grid.Column="1" Margin="5"/>
                            <TextBlock Text="m" Grid.Row="6" Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="Gray"/>
                        </Grid>
                    </GroupBox>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Tải trọng">
                <StackPanel Margin="10">
                    <Button x:Name="btn_ketnoietabs" Click="btn_ketnoietabs_Click" Content="IMPORT TỪ ETABS" Height="40" Background="#FF007ACC" Foreground="White" FontWeight="Bold" Cursor="Hand"/>
                    <GroupBox Header="Giá trị tải trọng chân cột" Margin="0,15,0,0" Padding="10" Height="290">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                                <RowDefinition Height="35"/>
                            </Grid.RowDefinitions>

                            <Label Content="Lực dọc N (kN):" Grid.Row="0"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Margin="5,2"/>

                            <Label Content="Momen Mx (kNm):" Grid.Row="1"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="5,2"/>

                            <Label Content="Momen My (kNm):" Grid.Row="2"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Margin="5,2"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <TabItem Header="Vật liệu">
                <Grid Margin="10">
                    <StackPanel>
                        <Label Content="Cấp độ bền bê tông (B):"/>
                        <ComboBox x:Name="cbBetong" Margin="5,0,5,10">
                            <ComboBoxItem Content="B20"/>
                            <ComboBoxItem Content="B22.5" IsSelected="True"/>
                            <ComboBoxItem Content="B25"/>
                            <ComboBoxItem Content="B30"/>
                        </ComboBox>

                        <Label Content="Nhóm cốt thép:"/>
                        <ComboBox x:Name="cbThep" Margin="5,0,5,10">
                            <ComboBoxItem Content="CB300-V"/>
                            <ComboBoxItem Content="CB400-V" IsSelected="True"/>
                        </ComboBox>

                        <Label Content="Lớp bê tông bảo vệ (mm):"/>
                        <TextBox Text="50" Margin="5,0,5,10"/>
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Kích thước">
                <StackPanel Margin="10">
                    <Label Content="Chiều dài (m):" Grid.Row="0"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Margin="5,2"/>

                    <Label Content="Chiều rộng (m):" Grid.Row="1"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="5,2"/>

                    <Label Content="Chiều sâu chôn móng(m):" Grid.Row="2" Width="333" />
                    <TextBox Grid.Row="2" Grid.Column="1" Margin="5,2"/>
                </StackPanel>

            </TabItem>
        </TabControl>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Button Content="Xác nhận " HorizontalAlignment="Center" Margin="0,414,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.315,-2.202" Width="114" Background="#FF628AEB" Height="34" FontSize="16"/>
            </Grid>

            <Grid Grid.Column="1" Background="#E9ECEF" Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#DEE2E6" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock Text="HÌNH VẼ MÓNG (3D)" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10" Foreground="#555" FontWeight="Bold"/>
                        <Canvas x:Name="canvas3D" Background="White" Margin="10,35,10,10"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1">
                    <Grid>
                        <TextBlock Text="MẶT BẰNG MÓNG (2D)" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="10" Foreground="#555" FontWeight="Bold"/>
                        <Canvas x:Name="canvas2D" Background="White" Margin="10,35,10,10"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="2" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="KẾT QUẢ TÍNH TOÁN" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#2C3E50" HorizontalAlignment="Center"/>

                        <GroupBox Header="KIỂM TRA NỀN ĐẤT" Margin="0,0,0,15" Padding="10" Background="White">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="35"/>
                                    <RowDefinition Height="45"/>
                                </Grid.RowDefinitions>

                                <Label Content="Áp lực Ptb (kN/m²):" Grid.Row="0" VerticalAlignment="Center"/>
                                <TextBox Name="txtPtc" Grid.Row="0" Grid.Column="1" IsReadOnly="True" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Background="#F8F9FA"/>

                                <Label Content="Cường độ R (kN/m²):" Grid.Row="1" VerticalAlignment="Center"/>
                                <TextBox Name="txtR" Grid.Row="1" Grid.Column="1" IsReadOnly="True" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Background="#F8F9FA"/>

                                <Label Content="Độ lún S (cm):" Grid.Row="2" VerticalAlignment="Center"/>
                                <TextBox Name="txtS" Grid.Row="2" Grid.Column="1" IsReadOnly="True" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" Background="#F8F9FA"/>

                                <Border Grid.Row="3" Grid.ColumnSpan="2" CornerRadius="5" Background="#D4EFDF" Margin="0,5,0,0">
                                    <TextBox Text="ĐIỀU KIỆN THỎA MÃN" Foreground="#1E8449" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="TÍNH TOÁN CỐT THÉP" Padding="10" Background="White">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <Label Content="Diện tích As yêu cầu:" VerticalAlignment="Center"/>
                                    <TextBox Name="txtAsReq" Grid.Column="1" IsReadOnly="True" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" FontWeight="Bold" Foreground="#C0392B" FontSize="14"/>
                                </Grid>
                                <UniformGrid Columns="2" Height="60">
                                    <StackPanel>
                                        <TextBlock Text="Phương X" HorizontalAlignment="Center" FontSize="11" Foreground="#7F8C8D"/>
                                        <TextBox Name="lblThepX" Text="12 Φ 16" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Phương Y" HorizontalAlignment="Center" FontSize="11" Foreground="#7F8C8D"/>
                                        <TextBox Name="lblThepY" Text="10 Φ 16" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

    </Grid>
</Window>
